{
  "name": "chat-backend-system",
  "version": "1.0.0",
  "description": "Strict TypeScript Chat Backend with PostgreSQL (users & chats) and Firebase Firestore (messages, read receipts, last seen)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/scripts/setupDb.ts"
  },
  "keywords": [
    "chat",
    "backend",
    "typescript",
    "postgresql",
    "firebase",
    "firestore",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "firebase-admin": "^13.0.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

